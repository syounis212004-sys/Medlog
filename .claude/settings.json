{
  "hooks": {
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$CLAUDE_PROJECT_DIR/.claude/enforce/enforce.py\" prompt", "timeout": 15}]}
    ],
    "PreToolUse": [
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Skill|mcp__github__create_pull_request|mcp__github__merge_pull_request|mcp__github__push_files|mcp__github__create_or_update_file",
       "hooks": [{"type": "command", "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$CLAUDE_PROJECT_DIR/.claude/enforce/enforce.py\" gate", "timeout": 30}]}
    ],
    "PostToolUse": [
      {"matcher": "Skill|Read|Grep|Glob|Bash|Edit|Write|MultiEdit|NotebookEdit",
       "hooks": [{"type": "command", "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$CLAUDE_PROJECT_DIR/.claude/enforce/enforce.py\" record", "timeout": 30}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$CLAUDE_PROJECT_DIR/.claude/enforce/enforce.py\" subagent-start", "timeout": 15}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$CLAUDE_PROJECT_DIR/.claude/enforce/enforce.py\" stop", "timeout": 20}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"$CLAUDE_PROJECT_DIR/.claude/enforce/enforce.py\" stop", "timeout": 20}]}
    ]
  }
}
